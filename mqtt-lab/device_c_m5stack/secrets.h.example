/*
 * secrets.h.example — 認証情報テンプレート
 *
 * このファイルを同じディレクトリに secrets.h という名前でコピーし、
 * 実際の値に書き換えてから使用してください。
 *
 *     cp secrets.h.example secrets.h
 *
 * secrets.h はリポジトリルートの .gitignore に登録されているため、
 * Gitの管理対象になりません。実際のSSID・パスワードが誤ってコミットされる
 * 事故を防ぐための構成です。
 *
 * ※ このファイル (secrets.h.example) 自体はコミットされます。
 *    実際の値をこちらに書かないよう注意してください。
 */

#pragma once

// WiFiアクセスポイントのSSID (ESP32は2.4GHz帯のみ対応)
#define SECRET_WIFI_SSID        "your-ssid"

// WiFiアクセスポイントのパスワード
#define SECRET_WIFI_PASSWORD    "your-password"

// ブローカー(デバイスB / Raspberry Pi)のIPアドレス。
// ホスト名 "raspberrypi.local" (mDNS) はESP32側の環境に依存して解決できない
// 場合があるため、IPアドレスでの指定を推奨する。
#define SECRET_MQTT_BROKER_HOST "192.168.1.100"
